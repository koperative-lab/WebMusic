  "directProbe": "import assert from 'node:assert/strict';\nimport {createRequire} from 'node:module';\nimport {readFileSync, existsSync} from 'node:fs';\nimport {dirname, join} from 'node:path';\nimport {pathToFileURL} from 'node:url';\nimport {get, getChord, degrees} from '@tonaljs/chord';\nimport {detect} from '@tonaljs/chord-detect';\nconst require = createRequire(import.meta.url);\nassert.deepEqual(get('Cmaj7').notes, ['C', 'E', 'G', 'B']);\nassert.deepEqual(getChord('m', 'D').notes, ['D', 'F', 'A']);\nassert.deepEqual(get('C/E').notes, ['E', 'G', 'C']);\nassert.equal(degrees(['C4', 'M'])(4), 'C5');\nassert.ok(detect(['C', 'E', 'G']).includes('CM'));\nconst seen = new Set();\nasync function visit(name, ownerRequire) {\n  const file = ownerRequire.resolve(name + '/package.json');\n  if (seen.has(file)) return;\n  seen.add(file);\n  const pkg = JSON.parse(readFileSync(file, 'utf8'));\n  assert.equal(pkg.license, 'MIT');\n  assert.ok(existsSync(join(dirname(file), 'LICENSE')));\n  for (const key of ['main', 'module', 'types']) {\n    assert.ok(pkg[key], name + ': missing ' + key);\n    assert.ok(existsSync(join(dirname(file), pkg[key])), name + ': invalid ' + key);\n  }\n  const cjs = ownerRequire(name);\n  const esm = await import(pathToFileURL(join(dirname(file), pkg.module)).href);\n  assert.ok(Object.keys(cjs).length && Object.keys(esm).length);\n  console.log(name + '@' + pkg.version + ': declared main/module/types, MIT text, CJS and raw ESM pass');\n  const nestedRequire = createRequire(file);\n  for (const child of Object.keys(pkg.dependencies ?? {})) if (child.startsWith('@tonaljs/')) await visit(child, nestedRequire);\n}\nawait visit('@tonaljs/chord', require);\nawait visit('@tonaljs/chord-detect', require);\nassert.deepEqual(require('@tonaljs/chord').get('Cmaj7').notes, ['C','E','G','B']);\nassert.ok(require('@tonaljs/chord-detect').detect(['C','E','G']).includes('CM'));\nconsole.log('PASS: direct Tonal bare ESM/CJS and raw ESM graph; ' + seen.size + ' package instances; chord, inversion and octave-preserving degree smoke tests.');\n",
  "typeProbe": "import {get, getChord, degrees} from '@tonaljs/chord';\nimport {detect} from '@tonaljs/chord-detect';\nconst notes: string[] = get('Cmaj7').notes;\nconst triad: string[] = getChord('m', 'D').notes;\nconst name: string = degrees(['C4', 'M'])(4);\nconst matches: string[] = detect(notes);\nvoid [notes, triad, name, matches];\n",
