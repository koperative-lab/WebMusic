---
import {getCollection, render} from 'astro:content';
import DocPage from '../site/DocPage.astro';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({params: {slug: entry.id === 'index' ? undefined : entry.id}, props: {entry}}));
}

const {entry} = Astro.props;
const {Content, headings} = await render(entry);
---

<DocPage title={entry.data.title} description={entry.data.description} headings={headings}>
  <Content />
</DocPage>
