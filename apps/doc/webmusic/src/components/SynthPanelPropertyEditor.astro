---
// Property-backed controls for <synth-panel>. The generic playground can
// generate rows for observed HTML attributes, while this element's useful
// configuration (sound descriptors, ADSR, EQ, LFO target and macros) is
// intentionally JavaScript-only. Keeping the row schema here gives those
// properties the same name / control / explanation rhythm as every generated
// attribute row without pretending they are attributes.

interface NumberField {
  key: string;
  label: string;
  kind: 'number';
  value: number;
  min: number;
  max: number;
  step: number;
  note: string;
}

interface SelectField {
  key: string;
  label: string;
  kind: 'select';
  value: string;
  options: readonly string[];
  note: string;
}

type Field = NumberField | SelectField;

interface Group {
  id: string;
  property: string;
  title: string;
  count: string;
  summary: string;
  open?: boolean;
  fields: readonly Field[];
}

const GROUPS: readonly Group[] = [
  {
    id: 'voice',
    property: '.sound',
    title: 'Sound parameters',
    count: '5 controls',
    summary: 'These values build the real .sound descriptor array and retune the oscillator while notes are playing.',
    open: true,
    fields: [
      {key: 'wave', label: 'wave', kind: 'select', value: 'triangle', options: ['sine', 'square', 'sawtooth', 'triangle'], note: 'Oscillator waveform; supplied as an options-backed SoundParam.'},
      {key: 'tune', label: 'tune', kind: 'number', value: 0, min: -50, max: 50, step: 1, note: 'Pitch offset in cents.'},
      {key: 'level', label: 'level', kind: 'number', value: 0.18, min: 0.01, max: 0.5, step: 0.01, note: 'Per-note oscillator gain.'},
      {key: 'cutoff', label: 'cutoff', kind: 'number', value: 8000, min: 200, max: 12000, step: 10, note: 'Low-pass cutoff in Hz; also the LFO target.'},
      {key: 'resonance', label: 'resonance', kind: 'number', value: 0.7, min: 0.1, max: 18, step: 0.1, note: 'Low-pass filter Q.'},
    ],
  },
  {
    id: 'envelope',
    property: '.envelope + .ranges',
    title: 'Envelope',
    count: 'ADSR + ranges',
    summary: 'The four values set .envelope. The three maxima set .ranges and scale the graph without changing the ADSR itself.',
    open: true,
    fields: [
      {key: 'attack', label: 'attack', kind: 'number', value: 0.05, min: 0, max: 4, step: 0.01, note: 'Seconds to reach the peak.'},
      {key: 'decay', label: 'decay', kind: 'number', value: 0.2, min: 0, max: 4, step: 0.01, note: 'Seconds from peak to sustain.'},
      {key: 'sustain', label: 'sustain', kind: 'number', value: 0.6, min: 0, max: 1, step: 0.01, note: 'Held level from 0 to 1.'},
      {key: 'release', label: 'release', kind: 'number', value: 0.4, min: 0, max: 4, step: 0.01, note: 'Seconds to fade after note-off.'},
      {key: 'attack-max', label: 'attackMax', kind: 'number', value: 2, min: 0.1, max: 10, step: 0.1, note: 'Attack range represented by the first quarter of the graph.'},
      {key: 'decay-max', label: 'decayMax', kind: 'number', value: 2, min: 0.1, max: 10, step: 0.1, note: 'Decay range represented by the second quarter.'},
      {key: 'release-max', label: 'releaseMax', kind: 'number', value: 2, min: 0.1, max: 10, step: 0.1, note: 'Release range represented by the final quarter.'},
    ],
  },
  {
    id: 'eq',
    property: '.bands',
    title: 'Equalizer bands',
    count: '3 bands',
    summary: 'Each committed field replaces .bands and rebuilds the internal EQ while the panel keeps the same external input and output.',
    fields: [
      {key: 'low-frequency', label: 'low.frequency', kind: 'number', value: 120, min: 30, max: 500, step: 1, note: 'Low-band centre frequency in Hz.'},
      {key: 'low-gain', label: 'low.gain', kind: 'number', value: 0, min: -18, max: 18, step: 0.5, note: 'Low-band boost or cut in dB.'},
      {key: 'low-q', label: 'low.q', kind: 'number', value: 0.8, min: 0.1, max: 20, step: 0.1, note: 'Low-band width.'},
      {key: 'mid-frequency', label: 'mid.frequency', kind: 'number', value: 1000, min: 200, max: 5000, step: 1, note: 'Mid-band centre frequency in Hz.'},
      {key: 'mid-gain', label: 'mid.gain', kind: 'number', value: 0, min: -18, max: 18, step: 0.5, note: 'Mid-band boost or cut in dB.'},
      {key: 'mid-q', label: 'mid.q', kind: 'number', value: 0.9, min: 0.1, max: 20, step: 0.1, note: 'Mid-band width.'},
      {key: 'high-frequency', label: 'high.frequency', kind: 'number', value: 6000, min: 2000, max: 18000, step: 1, note: 'High-band centre frequency in Hz.'},
      {key: 'high-gain', label: 'high.gain', kind: 'number', value: 0, min: -18, max: 18, step: 0.5, note: 'High-band boost or cut in dB.'},
      {key: 'high-q', label: 'high.q', kind: 'number', value: 0.9, min: 0.1, max: 20, step: 0.1, note: 'High-band width.'},
    ],
  },
  {
    id: 'modulation',
    property: '.lfo + .target + .macros',
    title: 'LFO and macros',
    count: '9 controls',
    summary: 'The LFO state drives one borrowed cutoff target. Two macro descriptors fan one knob out to several oscillator parameters.',
    fields: [
      {key: 'lfo-shape', label: 'lfo.shape', kind: 'select', value: 'sine', options: ['sine', 'triangle', 'square', 'saw'], note: 'Waveform used by the modulation controller.'},
      {key: 'lfo-rate', label: 'lfo.rate', kind: 'number', value: 1, min: 0.05, max: 12, step: 0.05, note: 'Modulation cycles per second.'},
      {key: 'lfo-depth', label: 'lfo.depth', kind: 'number', value: 0.6, min: 0, max: 1, step: 0.01, note: 'Fraction of the target range swept by the LFO.'},
      {key: 'lfo-phase', label: 'lfo.phase', kind: 'number', value: 0, min: 0, max: 1, step: 0.01, note: 'Normalized starting position within one modulation cycle.'},
      {key: 'lfo-running', label: 'lfo.running', kind: 'select', value: 'off', options: ['off', 'on'], note: 'Starts or stops modulation without losing its settings.'},
      {key: 'lfo-min', label: 'target.min', kind: 'number', value: 400, min: 20, max: 12000, step: 10, note: 'Lowest cutoff the LFO can apply.'},
      {key: 'lfo-max', label: 'target.max', kind: 'number', value: 9000, min: 20, max: 20000, step: 10, note: 'Highest cutoff the LFO can apply.'},
      {key: 'bright', label: 'BRIGHT value', kind: 'number', value: 0.5, min: 0, max: 1, step: 0.01, note: 'Macro position controlling cutoff and resonance.'},
      {key: 'body', label: 'BODY value', kind: 'number', value: 0.5, min: 0, max: 1, step: 0.01, note: 'Macro position controlling level and detune.'},
    ],
  },
];
---

<section
  class="wm-pg__collection syp-properties"
  data-syp-properties
  aria-labelledby="syp-properties-title"
>
  <div class="wm-pg__collection-header">
    <div class="wm-pg__collection-heading">
      <span class="wm-pg__collection-title" id="syp-properties-title">Panel properties</span>
      <span class="wm-pg__collection-count">sound · ADSR · EQ · modulation</span>
    </div>
  </div>

  <p class="wm-pg__collection-help">
    These controls assign the component's real JavaScript properties. Number edits commit on
    change, so an audio graph is never rebuilt for each digit while you type.
  </p>

  <div class="wm-pg__collection-list">
    {GROUPS.map((group) => (
      <details class="wm-pg__collection-item" open={group.open} data-syp-group={group.id}>
        <summary class="wm-pg__collection-summary">
          <code>{group.property}</code>
          <strong>{group.title}</strong>
          <span>{group.count}</span>
        </summary>
        <p class="wm-pg__effect-description">{group.summary}</p>
        <div class="wm-pg__collection-fields">
          {group.fields.map((field) => (
            <label class="wm-pg__param">
              <span class="wm-pg__name">{field.label}</span>
              {field.kind === 'select' ? (
                <select
                  class="wui-select"
                  data-syp-param={field.key}
                  data-syp-default={field.value}
                >
                  {field.options.map((option) => (
                    <option value={option} selected={option === field.value}>{option}</option>
                  ))}
                </select>
              ) : (
                <input
                  class="wm-pg__input"
                  type="number"
                  data-syp-param={field.key}
                  data-syp-default={field.value}
                  value={field.value}
                  min={field.min}
                  max={field.max}
                  step={field.step}
                  required
                />
              )}
              <span class="wm-pg__note">{field.note}</span>
            </label>
          ))}
        </div>
      </details>
    ))}
  </div>

  <p class="wm-pg__collection-status" data-syp-status aria-live="polite" aria-atomic="true"></p>
</section>
