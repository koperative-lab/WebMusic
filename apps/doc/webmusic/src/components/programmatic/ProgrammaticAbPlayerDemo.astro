---
import HeadlessDemoFrame from '../HeadlessDemoFrame.astro';
---
<HeadlessDemoFrame
  entry="@webmusic/score/play/headless"
  name="AbPlayer"
  hint="Use the live controls to hear the result. Reset stops playback and restores the default parameters."
  code={`// Configure AbPlayer below.`}
  rootAttrs={{'data-programmatic-abplayer': true}}
>
  <div class="wui-row"><button class="wui-btn" data-play type="button">▶ Play</button><span class="wui-readout wui-readout--wide" data-readout>—</span></div>
  <div slot="parameters" class="wm-pg__grid">
    <div class="wm-pg__param"><span class="wm-pg__name">select</span><div class="wui-seg" data-takes><button class="wui-btn" data-variant="ghost" data-select="A" type="button" aria-pressed="true">A · MIDI</button><button class="wui-btn" data-variant="ghost" data-select="B" type="button" aria-pressed="false">B · MXL</button></div><span class="wm-pg__note">Compare two imports of Arabesque No. 1 through ab.select(id).</span></div>
  </div>
</HeadlessDemoFrame>

<script>
  import {mountProgrammaticDemo, programmaticCode} from './programmatic-demo-lifecycle';
  import { AbPlayer, Sound } from '@webmusic/score/play/headless';
  import {arabesqueExcerpt, loadArabesqueScore} from '../headless/arabesque-score';

  mountProgrammaticDemo('[data-programmatic-abplayer]', async (root, scope) => {
    const [midi, mxl] = await Promise.all([loadArabesqueScore('midi'), loadArabesqueScore('mxl')]);
    if (!scope.active) return;
    const midiTake = arabesqueExcerpt(midi);
    const mxlTake = arabesqueExcerpt(mxl);
    const playBtn = root.querySelector('[data-play]') as HTMLButtonElement;
    const selectBtns = Array.from(
      root.querySelectorAll('[data-select]'),
    ) as HTMLButtonElement[];
    const readout = root.querySelector('[data-readout]') as HTMLElement;

    const sound = Sound.oscillator({type: 'triangle', gain: 0.2, releaseSeconds: 0.05});
    scope.add(() => sound.dispose()); // AbPlayer borrows the injected sound.
    const ab = new AbPlayer(
      { A: midiTake, B: mxlTake },
      {sound},
    );
    scope.add(() => ab.dispose());

    const paintActive = () => {
      programmaticCode(root, `import {AbPlayer, Sound} from '@webmusic/score/play/headless';

const sound = Sound.oscillator({type: 'triangle', gain: 0.2, releaseSeconds: 0.05});
const ab = new AbPlayer({A: midiTake, B: mxlTake}, {sound});
ab.select('${ab.active}');
// In a play gesture: await ab.play();
// On cleanup: ab.dispose(); sound.dispose();`);
      for (const btn of selectBtns) {
        btn.dataset.on = String(btn.dataset.select === ab.active);
        btn.setAttribute('aria-pressed', String(btn.dataset.select === ab.active));
      }
    };

    ab.player.on('beat', ({ beat, total }) => {
      readout.textContent = `take ${ab.active} · beat ${beat + 1}/${total}`;
    });

    selectBtns.forEach((btn) => {
      scope.listen(btn, 'click', () => {
        ab.select(btn.dataset.select as string);
        paintActive();
        if (!ab.playing) readout.textContent = `take ${ab.active} · ready`;
      });
    });

    let requestedPlaying = false;
    scope.listen(playBtn, 'click', () => {
      if (requestedPlaying) {
        requestedPlaying = false;
        ab.pause();
        playBtn.textContent = '▶ Play';
      } else {
        requestedPlaying = true;
        scope.run(ab.play(), () => { requestedPlaying = false; playBtn.textContent = '▶ Play'; });
        playBtn.textContent = '⏸ Pause';
      }
    });

    paintActive();
    readout.textContent = `take ${ab.active} · ready`;
  });
</script>
