---
// CANONICAL programmatic-demo pattern. Each demo has a title bar and
// a body whose UI is wired client-side to a programmatic API — no custom
// element involved. This one is analysis-only (no audio): an incremental
// AnalysisSession over an evolving score.
import LiveDemoCanvas from '../LiveDemoCanvas.astro';
---
<div class="wui-panel wui-panel--flow not-content" data-programmatic-analysissession>
  <div class="wui-panel__title">
    <span>@webmusic/score/analyze/headless</span>
    <strong>createAnalysisSession</strong>
  </div>
  <LiveDemoCanvas>
    <div class="wui-row">
      <button class="wui-btn" data-mutate type="button">Mutate score ▸</button>
      <div class="programmatic-demo__stack">
        <span class="wui-readout" data-key>key: —</span>
        <span class="wui-readout" data-chords>chords: —</span>
        <span class="wui-readout" data-roman>roman: —</span>
      </div>
    </div>
  </LiveDemoCanvas>
</div>

<script>
  import {mountDemos} from '../demo-lifecycle';
  import { Duration, MeasureId, PartId, Pitch, Rational, ScoreBuilder, VoiceId } from '@webmusic/score';
  import { createAnalysisSession } from '@webmusic/score/analyze/headless';

  // A clear diatonic phrase. `variant` swaps in a different mode/contour so the
  // mutated score re-analyzes to a new key + chords.
  function sampleScore(variant: 0 | 1) {
    const b = new ScoreBuilder();
    const partId = PartId('piano');
    const voice = VoiceId('v1');
    const timeSignature = { numerator: 4, denominator: 4 };
    b.setMetadata({ title: 'Phrase' })
      .addTempo({ atQuarters: Rational.ZERO, bpm: 100 })
      .addMeter({ atQuarters: Rational.ZERO, measureNumber: 1, timeSignature });
    b.addPart({ id: partId, name: 'Piano', staves: 1 });
    // variant 0: C major (I–IV–V–I outline). variant 1: A minor / G-leaning.
    const pitches = variant === 0
      ? ['C4','E4','G4','C5','F4','A4','C5','F5','G4','B4','D5','G5','C5','G4','E4','C4']
      : ['A3','C4','E4','A4','D4','F4','A4','D5','E4','G4','B4','E5','A4','E4','C4','A3'];
    pitches.forEach((name, i) => {
      const measureNumber = Math.floor(i / 8) + 1;
      if (i % 8 === 0) {
        b.addMeasure({
          id: MeasureId(`m${measureNumber}`),
          number: measureNumber,
          onsetQuarters: new Rational((measureNumber - 1) * 4, 1),
          durationQuarters: new Rational(4, 1),
          timeSignature,
        });
      }
      b.addNote(partId, {
        id: b.newNoteId(),
        pitch: Pitch.parse(name),
        onsetQuarters: new Rational(i, 2),
        duration: Duration.eighth(),
        voice,
      });
    });
    return b.build();
  }

  mountDemos('[data-programmatic-analysissession]', (root, scope) => {
    const btn = root.querySelector('[data-mutate]') as HTMLButtonElement;
    const keyEl = root.querySelector('[data-key]') as HTMLElement;
    const chordsEl = root.querySelector('[data-chords]') as HTMLElement;
    const romanEl = root.querySelector('[data-roman]') as HTMLElement;

    const session = createAnalysisSession(sampleScore(0), { windowQuarters: 2 });

    const render = () => {
      const r = session.result;
      const k = r.key;
      keyEl.textContent = `key: ${k.tonic} ${k.mode} (conf ${k.confidence.toFixed(2)})`;
      const labels = r.chords.slice(0, 4).map((c) => c.chord).join(', ');
      chordsEl.textContent = `chords: ${r.chords.length} · ${labels}${r.chords.length > 4 ? ', …' : ''}`;
      const numerals = r.roman.slice(0, 6).map((rn) => rn.roman).join(' ');
      romanEl.textContent = `roman: ${numerals || '—'}`;
    };
    render();

    let variant: 0 | 1 = 0;
    scope.listen(btn, 'click', () => {
      variant = variant === 0 ? 1 : 0;
      // Incremental re-analysis: feed the next score to the live session.
      session.update(sampleScore(variant));
      render();
      btn.textContent = variant === 0 ? 'Mutate score ▸' : 'Revert score ▸';
    });
  });
</script>

<style>
  /* The three results stack full-width under the button rather than sharing
     the row's baseline. */
  .programmatic-demo__stack {
    display: flex; flex: 1 1 100%; flex-direction: column;
    align-items: stretch; gap: 0.4rem;
  }
</style>
