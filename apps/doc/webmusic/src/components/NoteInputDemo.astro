---
// One real <score-note-input> demonstrates every surface. The public `layout`
// parameter switches that same element between piano, grid, and chords; the
// preloaded map keeps the grid playable when readers switch to it.
import {DEFAULT_TR808_GRID_MAP} from '@webmusic/score/play/element';
import ElementPlayground from './ElementPlayground.astro';
---

<ElementPlayground
  tag="score-note-input"
  target="[data-ni-input]"
  markup="[data-ni-composition]"
  class="ni-demo"
  omit={['row-interval']}
>
  <div class="ni-demo__composition" data-ni-composition data-pg-fragment>
    <score-note-input
      data-ni-input
      data-ni-wire
      layout="piano"
      start="48"
      end="71"
      map={DEFAULT_TR808_GRID_MAP}
    ></score-note-input>
  </div>

</ElementPlayground>

<script>
  import {defineNoteInputElement, type NoteInputElement} from '@webmusic/score/play/element';
  import {mountDemos} from './demo-lifecycle';
  import {monitorNoteInput} from './note-input-monitor';

  defineNoteInputElement();
  mountDemos('score-note-input[data-ni-wire]', (node, scope) => {
    monitorNoteInput(node as NoteInputElement, scope);
  });
</script>

<style>
  .ni-demo :global(.ni-demo__composition) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
    min-width: 0;
  }
</style>
