---
// miniMeter-style waveform: the amplitude waveform tinted by its spectral
// content (bass → red, mid → green, treble → blue), with a control panel
// placed beside Parameters, outside the live canvas:
//   Channel 1 / Channel 2 — pick Left / Right / Mid / Side; a second channel
//     stacks a stereo split, each half coloured by its own spectrum.
//   Color Mode — Static / Multi-Band / Color Map (the `color-mode` attribute).
//   History     — a recent-history glow that follows the playhead while playing.
//   Loop / Speed — drive the bound player.
// The SHAPE is amplitude peaks; the COLOUR is a spectrogram, recomputed per
// channel.
//
// The device panel already owns `color-mode`, `channel-layout` and `history`, so
// the parameter strip below shows the knobs it does NOT own — the same element,
// driven from the other side. The main playground owns the complete surface.
import ElementPlayground from './ElementPlayground.astro';

const ONLY = [
  'pixels-per-second', 'height', 'amplitude', 'bands', 'color-map', 'wave-color',
  'progress-color', 'playhead-color', 'background-color', 'drag-mode', 'follow', 'scrollable',
];
---

<ElementPlayground
  tag="audio-view"
  only={ONLY}
  markup="[data-mm]"
>
  <div class="mm-device" data-mm>
    <audio-player id="mm-player" controls></audio-player>
    <audio-view id="mm-view" input="#mm-player" type="waveform" pixels-per-second="90" height="160" interactive drag-mode="scrub" color-mode="multiband"></audio-view>

    <p class="wm-demo-help" data-drag-help>The playhead stays centered. Drag left forward or right backward to scratch; release coasts, then restores the previous playback state.</p>
    <p role="status" class="wm-demo-status" data-mm-status></p>
  </div>
  <div slot="controls" data-mm-controls>
    <div class="mm-panel" aria-label="Channels and colour">
      <div class="mm-row">
        <span class="mm-label">Channel 1:</span>
        <div class="mm-seg" data-group="ch1" role="group" aria-label="Channel 1 source">
          <button type="button" data-val="left" class="active" aria-pressed="true">Left</button>
          <button type="button" data-val="right" aria-pressed="false">Right</button>
          <button type="button" data-val="mid" aria-pressed="false">Mid</button>
          <button type="button" data-val="side" aria-pressed="false">Side</button>
        </div>
        <label class="mm-toggle"><span>Loop</span><input type="checkbox" data-ctl="loop" /></label>
      </div>
      <div class="mm-row">
        <span class="mm-label">Channel 2:</span>
        <div class="mm-seg" data-group="ch2" role="group" aria-label="Channel 2 source">
          <button type="button" data-val="off" class="active" aria-pressed="true">Off</button>
          <button type="button" data-val="left" aria-pressed="false">Left</button>
          <button type="button" data-val="right" aria-pressed="false">Right</button>
          <button type="button" data-val="mid" aria-pressed="false">Mid</button>
          <button type="button" data-val="side" aria-pressed="false">Side</button>
        </div>
      </div>
      <div class="mm-row">
        <span class="mm-label">Color Mode:</span>
        <div class="mm-seg" data-group="colormode" role="group" aria-label="Color mode">
          <button type="button" data-val="static" aria-pressed="false">Static</button>
          <button type="button" data-val="multiband" class="active" aria-pressed="true">Multi-Band</button>
          <button type="button" data-val="colormap" aria-pressed="false">Color Map</button>
        </div>
      </div>
      <div class="mm-row">
        <span class="mm-label">History:</span>
        <div class="mm-seg" data-group="history" role="group" aria-label="History trail">
          <button type="button" data-val="0" class="active" aria-pressed="true">Off</button>
          <button type="button" data-val="0.6" aria-pressed="false">Fast</button>
          <button type="button" data-val="2.5" aria-pressed="false">Slow</button>
        </div>
      </div>
      <div class="mm-row">
        <span class="mm-label">Speed:</span>
        <input class="wui-range" type="range" data-ctl="speed" min="0.25" max="2" step="0.05" value="1" aria-label="Playback speed" />
        <output class="mm-num" data-speed>1.00</output>
      </div>
    </div>
  </div>
</ElementPlayground>

<script>
  import {defineAudioPlayerElement, type AudioPlayerElement} from '@webmusic/audio/play/element';
  import {defineAudioViewElement, type AudioViewElement} from '@webmusic/audio/view/element';
  import {mountDemos} from './demo-lifecycle';
  import {acquireAudioViewFixture, whenDemoVisible, type DemoChannel} from './audio-view-fixture';
  import {PLAYGROUND_RESET_EVENT} from './playground-client';

  defineAudioPlayerElement();
  defineAudioViewElement();

  mountDemos('[data-mm]', (device, scope) => {
    const view = device.querySelector<AudioViewElement>('audio-view')!;
    const player = device.querySelector<AudioPlayerElement>('audio-player')!;
    const status = device.querySelector<HTMLElement>('[data-mm-status]')!;
    const fixture = acquireAudioViewFixture(`${import.meta.env.BASE_URL}wav/Arabesque%20No.1.wav`);
    const help = device.querySelector<HTMLElement>('[data-drag-help]');
    // The channel and colour controls live with Parameters, outside the canvas.
    const controls = device.closest<HTMLElement>('[data-wm-pg]') ?? device;
    const updateHelp = (): void => {
      if (!help) return;
      const mode = view.getAttribute('drag-mode');
      if (mode === 'pan') help.textContent = /^(false|0|no|off)$/i.test(view.getAttribute('scrollable')?.trim() ?? '')
        ? 'Panning is disabled. Enable scrollable to move this viewport.'
        : 'Drag left to see later audio, or right to see earlier audio. Arrow keys move the window. Playback is unchanged; following is suspended in pan mode.';
      else if (mode === 'scrub') help.textContent = 'Centered scrub: drag left toward later audio, or right toward earlier audio. Decoded players scratch at your speed; release coasts in position and sound, then restores the previous playback state. Other players move position only.';
      else if (mode === 'none') help.textContent = 'Click or use arrow keys to seek. Dragging does not move playback.';
      else help.textContent = 'Drag or click to seek to the time under the pointer. Arrow keys seek too.';
    };
    updateHelp();
    const helpObserver = new MutationObserver(updateHelp);
    helpObserver.observe(view, {attributes: true, attributeFilter: ['drag-mode', 'scrollable']});
    scope.add(() => helpObserver.disconnect());
    scope.add(() => fixture.release());
    scope.add(() => { player.stop(); player.clip = undefined; player.loading = false; view.peaks = undefined; view.frequencyData = undefined; view.loading = false; });
    let ch1: DemoChannel = 'left';
    let ch2: DemoChannel | 'off' = 'off';
    let ready = false;
    let generation = 0;
    const applyView = async (): Promise<void> => {
      const current = ++generation;
      if (!ready) return;
      const selected = ch2 === 'off' ? [ch1] : [ch1, ch2];
      const coloured = view.getAttribute('color-mode') !== 'static';
      delete status.dataset.error;
      status.textContent = '';
      view.loading = true;
      try {
        const peaks = await fixture.peaks(selected);
        if (!scope.active || current !== generation) return;
        view.setAttribute('channel-layout', ch2 === 'off' ? 'merge' : 'split');
        view.frequencyData = undefined;
        view.peaks = peaks;
        if (coloured) {
          const spectra = await Promise.all(selected.map((key) => fixture.spectrum(key)));
          if (!scope.active || current !== generation) return;
          view.frequencyData = spectra.length === 1 ? spectra[0] : spectra;
        }
        status.textContent = '';
      } catch (error) {
        if (scope.active && current === generation) { status.textContent = 'Channel data could not be prepared. Choose a channel to retry.'; status.dataset.error = ''; }
        throw error;
      } finally {
        if (scope.active && current === generation) view.loading = false;
      }
    };
    const setActive = (seg: Element, value: string): void => {
      for (const button of seg.querySelectorAll<HTMLButtonElement>('button')) {
        const active = button.dataset.val === value;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      }
    };
    for (const seg of controls.querySelectorAll<HTMLElement>('.mm-seg')) {
      scope.listen(seg, 'click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button');
        if (!button || !seg.contains(button)) return;
        const value = button.dataset.val!;
        setActive(seg, value);
        switch (seg.dataset.group) {
          case 'ch1': ch1 = value as DemoChannel; scope.run(applyView()); break;
          case 'ch2': ch2 = value as DemoChannel | 'off'; scope.run(applyView()); break;
          case 'colormode': view.setAttribute('color-mode', value); scope.run(applyView()); break;
          case 'history': view.setAttribute('history', value); break;
        }
      });
    }
    const loop = controls.querySelector<HTMLInputElement>('[data-ctl="loop"]')!;
    scope.listen(loop, 'change', () => player.toggleAttribute('loop', loop.checked));
    const speed = controls.querySelector<HTMLInputElement>('[data-ctl="speed"]')!;
    const speedOut = controls.querySelector('[data-speed]')!;
    scope.listen(speed, 'input', () => {
      player.setAttribute('rate', speed.value);
      speedOut.textContent = Number(speed.value).toFixed(2);
    });
    const panel = device.closest<HTMLElement>('[data-wm-pg]');
    if (panel) scope.listen(panel, PLAYGROUND_RESET_EVENT, () => {
      player.stop();
      ch1 = 'left'; ch2 = 'off';
      view.setAttribute('color-mode', 'multiband');
      view.removeAttribute('history');
      player.removeAttribute('loop'); player.removeAttribute('rate');
      loop.checked = false; speed.value = '1'; speedOut.textContent = '1.00';
      const defaults: Record<string, string> = {ch1: 'left', ch2: 'off', colormode: 'multiband', history: '0'};
      for (const seg of controls.querySelectorAll<HTMLElement>('.mm-seg')) setActive(seg, defaults[seg.dataset.group!]);
      scope.run(applyView());
    });
    whenDemoVisible(device, scope, async () => {
      status.textContent = '';
      view.loading = true;
      player.loading = true;
      try {
        // Awaiting the shared pyramid prevents the player binding deriving a duplicate.
        const [clip, peaks] = await Promise.all([fixture.clip(), fixture.peaks(['left'])]);
        if (!scope.active) return;
        view.peaks = peaks;
        player.clip = clip;
        player.loading = false;
        ready = true;
        scope.run(applyView());
      } catch (error) {
        if (scope.active) {
          view.loading = false;
          player.loading = false;
          status.textContent = 'Audio could not be loaded. Reload this page to retry.';
          status.dataset.error = '';
        }
        throw error;
      }
    });
  });
</script>

<style>
  /* The device follows the kit: neutral surface, hairlines, square cells. */
  .mm-device { display: flex; flex-direction: column; gap: .75rem; min-width: 0; }
  .mm-device :global(audio-view) { display: block; min-height: 160px; }
  .mm-panel { display: grid; gap: .5rem; }
  .mm-row { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; min-width: 0; }
  .mm-label {
    min-width: 6rem; color: var(--wm-foreground-muted, light-dark(#777, #aaa));
    font: .625rem/1 var(--wm-font-mono, ui-monospace, monospace); text-transform: uppercase; letter-spacing: .06em;
  }
  .mm-seg { display: inline-flex; gap: 1px; background: var(--wm-control-border, var(--wm-border, light-dark(#d8d8d8, #333))); border: 1px solid var(--wm-control-border, var(--wm-border, light-dark(#d8d8d8, #333))); }
  .mm-seg button {
    appearance: none; margin: 0; border: 0; border-radius: 0; min-width: var(--wm-control-size, 2rem); height: var(--wm-control-size, 2rem); padding: 0 .5rem;
    background: var(--wm-surface, light-dark(#fff, #111)); color: var(--wm-foreground-muted, light-dark(#777, #aaa));
    font: .6875rem/1 var(--wm-font-mono, ui-monospace, monospace); cursor: pointer;
  }
  .mm-seg button:hover { color: var(--wm-foreground, light-dark(#111, #eee)); }
  .mm-seg button[aria-pressed='true'] { background: var(--wm-foreground, light-dark(#111, #eee)); color: var(--wm-accent-foreground, light-dark(#fff, #111)); }
  .mm-seg button:focus-visible { outline: var(--wm-focus-ring, 2px solid var(--wm-foreground, light-dark(#111, #eee))); outline-offset: -2px; }
  .mm-toggle {
    display: inline-flex; align-items: center; gap: .4rem; margin-left: auto; cursor: pointer;
    color: var(--wm-foreground-muted, light-dark(#777, #aaa)); font: .625rem/1 var(--wm-font-mono, ui-monospace, monospace); text-transform: uppercase; letter-spacing: .06em;
  }
  .mm-row input[type='range'] { accent-color: var(--wm-foreground, light-dark(#111, #eee)); max-width: 240px; flex: 1 1 160px; }
  .mm-num { min-width: 2.6rem; color: var(--wm-foreground, light-dark(#111, #eee)); font: .75rem/1 var(--wm-font-mono, ui-monospace, monospace); }
</style>
