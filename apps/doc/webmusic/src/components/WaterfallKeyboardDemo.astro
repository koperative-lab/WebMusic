---
import LiveDemoCanvas from './LiveDemoCanvas.astro';
---

<section class="aligned-demo not-content" data-waterfall-keyboard-demo>
  <LiveDemoCanvas label="Aligned waterfall and keyboard">
    <div class="aligned-demo__layout">
      <score-player id="aligned-waterfall-player" time-control="full" aria-label="Two-bar alignment study"></score-player>
      <p class="doc-status" data-aligned-status role="status">Preparing score…</p>
      <div class="aligned-demo__controls">
        <label>Pitch width
          <select class="doc-select" data-aligned-width>
            <option value="24/15">24 / 15px</option>
            <option value="32/20" selected>32 / 20px</option>
            <option value="40/25">40 / 25px</option>
          </select>
        </label>
        <label>Note length
          <select class="doc-select" data-aligned-time-scale>
            <option value="32">32px / second</option>
            <option value="64" selected>64px / second</option>
            <option value="96">96px / second</option>
          </select>
        </label>
        <label>Key height
          <select class="doc-select" data-aligned-key-height>
            <option value="64">64px</option>
            <option value="80" selected>80px</option>
            <option value="112">112px</option>
          </select>
        </label>
      </div>
      <div class="aligned-demo__pan" tabindex="0" role="region" aria-label="Pan waterfall and keyboard together">
        <div class="aligned-demo__track" data-aligned-track>
          <score-view type="waterfall" player="#aligned-waterfall-player" min-pitch="48" max-pitch="71"
            white-note-width="32" black-note-width="20" pixels-per-second="64" note-spacing="0"
            show-annotations="false" height="180"></score-view>
          <pitch-view type="keyboard" player="#aligned-waterfall-player" low="48" high="71"
            white-key-width="32" black-key-width="20" white-key-height="80" black-key-height="50" follow="none"></pitch-view>
        </div>
      </div>
    </div>
  </LiveDemoCanvas>
</section>

<script>
  import {defineScorePlayerElement} from '@webmusic/score/play/element';
  import {definePitchViewElement, defineScoreViewElement} from '@webmusic/score/view/element';
  import {mountDemos} from './demo-lifecycle';
  import {mountWaterfallKeyboardDemo} from './waterfall-keyboard-client';

  defineScorePlayerElement();
  defineScoreViewElement();
  definePitchViewElement();
  mountDemos('[data-waterfall-keyboard-demo]', mountWaterfallKeyboardDemo);
</script>

<style>
  .aligned-demo { margin-block: 1.5rem; }
  .aligned-demo__layout { display: grid; gap: .75rem; min-width: 0; }
  .aligned-demo__controls { display: flex; flex-wrap: wrap; gap: .65rem 1rem; }
  .aligned-demo__controls label { display: grid; gap: .25rem; font-size: .75rem; }
  .aligned-demo__pan { max-width: 100%; overflow-x: auto; border: 1px solid var(--wm-border, #d8d8d8); }
  .aligned-demo__track { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; width: 448px; }
  .aligned-demo__track > * {
    width: 100%; min-width: 0; margin: 0;
    --wm-component-padding: 0;
    --wm-component-border: 0;
    --wm-component-radius: 0;
    --wm-stage-surface-padding: 0;
    --wm-stage-surface-border: 0;
    --wm-pitch-surface-padding: 0;
    --wm-pitch-surface-border: 0;
    --wm-score-view-active-note: var(--wm-accent);
  }
</style>
