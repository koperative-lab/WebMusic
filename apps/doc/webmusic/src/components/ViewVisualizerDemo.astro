---
import LiveDemoCanvas from './LiveDemoCanvas.astro';

interface Props {
  demo?: 'piano-roll' | 'staff' | 'waterfall';
}

// Default to the piano roll so a bare <ViewVisualizerDemo /> still renders —
// an unset `demo` used to fall through every branch and show an empty panel.
const { demo = 'piano-roll' } = Astro.props;
---

<div class="wui-panel wui-panel--flow not-content view-visualizer-demo" data-view-demo={demo}>
  <div class="wui-panel__title">
    <span>@webmusic/score/view</span>
    <strong data-view-demo-title>Visualizer</strong>
  </div>
  <LiveDemoCanvas size="tall">
    <div class="view-visualizer-demo__surface" data-view-demo-surface></div>
  </LiveDemoCanvas>
</div>

<script>
  import { renderPianoRollVisualizer, renderStaffVisualizer, renderWaterfallVisualizer } from '@webmusic/score/view/render';
  import { arabesqueExcerpt, loadArabesqueScore } from './headless/arabesque-score';

  const demoScore = loadArabesqueScore('mxl').then((score) => arabesqueExcerpt(score, 16));

  const renderDemo = async (root: HTMLElement) => {
    if (root.dataset.initialized) return;
    root.dataset.initialized = 'true';
    const surface = root.querySelector<HTMLDivElement>('[data-view-demo-surface]')!;
    const title = root.querySelector<HTMLElement>('[data-view-demo-title]')!;
    const demo = root.dataset.viewDemo;
    let score: Awaited<typeof demoScore>;
    try {
      score = await demoScore;
    } catch {
      surface.textContent = 'Could not load the Arabesque score.';
      return;
    }
    if (!root.isConnected) return;

    if (demo === 'piano-roll') {
      title.textContent = 'Piano roll visualizer';
      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('role', 'img');
      svg.setAttribute('aria-label', 'Piano roll rendered by @webmusic/score/view');
      surface.appendChild(svg);
      renderPianoRollVisualizer(score, svg, {
        noteHeight: 12,
        noteSpacing: 2,
        pixelsPerSecond: 96,
        noteRGB: '17, 17, 17',
      });
    }

    if (demo === 'staff') {
      title.textContent = 'Staff visualizer';
      renderStaffVisualizer(score, surface, {
        noteHeight: 7,
        noteSpacing: 1,
        pixelsPerSecond: 0,
        noteRGB: '17, 17, 17',
      });
    }

    if (demo === 'waterfall') {
      title.textContent = 'Waterfall visualizer';
      renderWaterfallVisualizer(score, surface, {
        noteSpacing: 2,
        pixelsPerSecond: 64,
        whiteNoteWidth: 16,
        showOnlyOctavesUsed: true,
        noteRGB: '17, 17, 17',
      });
    }
  };

  document.querySelectorAll<HTMLElement>('[data-view-demo]').forEach(renderDemo);
</script>

<style>
  .view-visualizer-demo__surface {
    min-height: 220px;
    overflow: auto;
  }

  [data-view-demo='staff'] .view-visualizer-demo__surface {
    height: 280px;
  }

  [data-view-demo='waterfall'] .view-visualizer-demo__surface {
    height: 320px;
    overflow: hidden;
  }

  .view-visualizer-demo svg {
    display: block;
    width: 100%;
  }
</style>
