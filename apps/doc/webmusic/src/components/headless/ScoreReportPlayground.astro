---
import LiveDemoCanvas from '../LiveDemoCanvas.astro';
---

<div class="wui-panel wui-panel--flow not-content" data-score-report-demo>
  <div class="wui-panel__title">
    <span>Score · Headless + API</span>
    <strong>Score reports</strong>
  </div>
  <LiveDemoCanvas>
    <div data-report-output></div>
  </LiveDemoCanvas>
  <details>
    <summary>Parameters</summary>
  <div class="score-report-demo__controls">
    <label>Report
      <select data-report-kind>
        <option value="summary">Summary</option>
        <option value="histogram">Histogram</option>
        <option value="rhythm">Rhythm patterns</option>
      </select>
    </label>
    <label>Source
      <select data-score-variant>
        <option value="midi">Arabesque No. 1 · MIDI</option>
        <option value="mxl">Arabesque No. 1 · MXL</option>
      </select>
    </label>
    <label data-histogram-control hidden>Distribution
      <select data-distribution>
        <option value="pitchClasses">Pitch classes</option>
        <option value="intervals">Melodic intervals</option>
        <option value="durations">Note durations</option>
      </select>
    </label>
    <label data-rhythm-control hidden>Notes per pattern
      <select data-pattern-length>
        <option value="2">2</option>
        <option value="3">3</option>
        <option value="4" selected>4</option>
        <option value="6">6</option>
        <option value="8">8</option>
      </select>
    </label>
    <button class="wui-btn" data-report-reset type="button">Reset</button>
  </div>
  </details>
  <p class="score-report-demo__note" data-report-status role="status"></p>
  <code data-report-call>createScoreReport(score)</code>
  <details>
    <summary>Returned data</summary>
    <pre class="score-report-demo__data" data-report-data></pre>
  </details>
</div>

<script>
  import {mountDemos} from '../demo-lifecycle';
  import {distributions, rhythmPatterns} from '@webmusic/score/analyze';
  import {createScoreReport} from '@webmusic/score/analyze/headless';
  import {loadArabesqueScore, type ArabesqueFormat} from './arabesque-score';
  import {
    analysisStyle,
    createAnalysisRoot,
    renderHistogram,
    renderRhythmPatternList,
    renderSummaryCard,
    type AnalysisHistogramHandle,
  } from '@webmusic/ui/analysis';

  mountDemos('[data-score-report-demo]', (root, scope) => {
    const kind = root.querySelector<HTMLSelectElement>('[data-report-kind]')!;
    const variant = root.querySelector<HTMLSelectElement>('[data-score-variant]')!;
    const distribution = root.querySelector<HTMLSelectElement>('[data-distribution]')!;
    const length = root.querySelector<HTMLSelectElement>('[data-pattern-length]')!;
    const histogramControl = root.querySelector<HTMLElement>('[data-histogram-control]')!;
    const rhythmControl = root.querySelector<HTMLElement>('[data-rhythm-control]')!;
    const output = root.querySelector<HTMLElement>('[data-report-output]')!;
    const status = root.querySelector<HTMLElement>('[data-report-status]')!;
    const invocation = root.querySelector<HTMLElement>('[data-report-call]')!;
    const data = root.querySelector<HTMLElement>('[data-report-data]')!;
    let histogram: AnalysisHistogramHandle | undefined;
    let generation = 0;
    scope.add(() => { ++generation; histogram?.destroy(); });

    const render = async () => {
      const request = ++generation;
      status.textContent = 'Loading Arabesque No. 1...';
      let score;
      try {
        score = await loadArabesqueScore(variant.value as ArabesqueFormat);
      } catch (error) {
        if (scope.active && request === generation) status.textContent = error instanceof Error ? error.message : String(error);
        return;
      }
      if (!scope.active || request !== generation) return;
      histogram?.destroy();
      histogram = undefined;
      const surface = createAnalysisRoot(root.ownerDocument);
      const style = root.ownerDocument.createElement('style');
      style.textContent = analysisStyle;
      output.replaceChildren(style, surface);
      histogramControl.hidden = kind.value !== 'histogram';
      rhythmControl.hidden = kind.value !== 'rhythm';
      let result: unknown;
      if (kind.value === 'histogram') {
        const type = distribution.value === 'intervals' ? 'intervals'
          : distribution.value === 'durations' ? 'durations' : 'pitchClasses';
        const bins = distributions(score)[type];
        const total = bins.reduce((sum, bin) => sum + bin.value, 0);
        histogram = renderHistogram(bins, surface, {
          format: type === 'pitchClasses'
            ? (value) => `${total ? Math.round(value / total * 100) : 0}%`
            : (value) => String(value),
        });
        result = bins;
        status.textContent = type === 'pitchClasses'
          ? 'Bars show each pitch class’s share of total pitched-note duration weight; returned weights use ticks.'
          : type === 'intervals' ? 'Counts of signed melodic intervals in semitones, within each voice.'
          : 'Counts of note durations, labeled in quarter notes.';
        invocation.textContent = `distributions(score).${type}`;
      } else if (kind.value === 'rhythm') {
        const count = Number(length.value);
        const patterns = rhythmPatterns(score, count);
        renderRhythmPatternList(patterns, surface, {limit: 24, formatDuration: (quarters) => `${quarters}q`});
        result = patterns;
        status.textContent = `Showing the first 24 of ${patterns.length} patterns; returned data includes all. Durations and onset positions use quarter notes.`;
        invocation.textContent = `rhythmPatterns(score, ${count})`;
      } else {
        const report = createScoreReport(score);
        renderSummaryCard({title: report.title ?? 'Score report', subtitle: report.composer, rows: report.rows}, surface);
        result = report;
        status.textContent = 'Formatted facts for the selected Arabesque format. Changing the source recomputes the report.';
        invocation.textContent = 'createScoreReport(score)';
      }
      data.textContent = JSON.stringify(result, null, 2);
    };

    for (const control of [kind, variant, distribution, length]) scope.listen(control, 'change', render);
    scope.listen(root.querySelector('[data-report-reset]')!, 'click', () => {
      kind.value = 'summary';
      variant.value = 'midi';
      distribution.value = 'pitchClasses';
      length.value = '4';
      return render();
    });
    return render();
  });
</script>

<style>
  .score-report-demo__controls { display: flex; flex-wrap: wrap; align-items: end; gap: 1rem; }
  .score-report-demo__controls label { display: grid; gap: .35rem; }
  .score-report-demo__controls [hidden] { display: none !important; }
  .score-report-demo__controls select { max-width: 100%; padding: .4rem; font: inherit; }
  .score-report-demo__note { margin: 0; font-size: .875rem; }
  .score-report-demo__data { max-height: 22rem; overflow: auto; font-size: .75rem; }
</style>
