---
import ElementPlayground from '../ElementPlayground.astro';
import './editing-import.css';
const source = `${import.meta.env.BASE_URL}wav/Editing.wav`;
---

<ElementPlayground tag="audio-view" target="[data-audio-edit-view]" markup="[data-audio-edit-composition]"
  companions={[{tag: 'audio-player', target: '[data-audio-edit-player]'}]}>
  <section data-audio-edit-demo data-audio-edit-src={source} aria-label="Audio editing workflow">
    <div data-audio-edit-composition data-pg-fragment>
      <audio-player data-audio-edit-player id="audio-edit-player"></audio-player>
      <audio-view data-audio-edit-view player="#audio-edit-player" type="waveform" editable></audio-view>
    </div>
    <p data-audio-edit-status role="status">Loading the six-second audio example.</p>
    <div class="audio-edit-actions">
      <label class="editing-import">Import WAV <input data-audio-edit-import type="file" accept=".wav,audio/wav" aria-label="Import WAV" /></label>
      <button class="wui-btn" data-audio-edit-process="normalize" type="button">Normalize selection</button>
      <button class="wui-btn" data-audio-edit-process="reverse" type="button">Reverse selection</button>
      <button class="wui-btn" data-audio-edit-cancel type="button">Cancel processing</button>
      <button class="wui-btn" data-audio-edit-export type="button">Export WAV</button>
      <button class="wui-btn" data-audio-edit-restore type="button">Reload configured source</button>
    </div>
    <p data-audio-edit-result aria-live="polite">Select a range, then cut, trim, change gain or process it. Edits pause playback; press Play to hear the committed version.</p>
  </section>
</ElementPlayground>

<script>
  import {defineAudioPlayerElement, type AudioPlayerElement} from '@webmusic/audio/play/element';
  import {defineAudioViewElement, type AudioViewElement} from '@webmusic/audio/view/element';
  import {createAudioClipEditor, loadAudioClipEditor, type AudioClipEditor} from '@webmusic/audio/view/headless';
  import {createAudioRangeProcessor} from '@webmusic/audio/view';
  import {exportAudioSequenceWav, loadClip} from '@webmusic/audio/play';
  import {mountDemos} from '../demo-lifecycle';
  import {PLAYGROUND_RESET_EVENT} from '../playground-client';
  defineAudioPlayerElement(); defineAudioViewElement();
  mountDemos('[data-audio-edit-demo]', (root, scope) => {
    // The demo owns one editor at a time. The player and the view borrow it
    // through `.editor`; replacing or tearing down disposes the previous one.
    const source = root.dataset.audioEditSrc!;
    const player = root.querySelector<AudioPlayerElement>('[data-audio-edit-player]')!;
    const view = root.querySelector<AudioViewElement>('[data-audio-edit-view]')!;
    const status = root.querySelector<HTMLElement>('[data-audio-edit-status]')!;
    const result = root.querySelector<HTMLElement>('[data-audio-edit-result]')!;
    const upload = root.querySelector<HTMLInputElement>('[data-audio-edit-import]')!;
    const exportButton = root.querySelector<HTMLButtonElement>('[data-audio-edit-export]')!;
    const cancelButton = root.querySelector<HTMLButtonElement>('[data-audio-edit-cancel]')!;
    const processButtons = root.querySelectorAll<HTMLButtonElement>('[data-audio-edit-process]');
    const initialMessage = result.textContent;
    const processors = [createAudioRangeProcessor('normalize'), createAudioRangeProcessor('reverse')];
    let editor: AudioClipEditor | undefined;
    let documentStatus = 'loading';
    let bindingError: string | undefined;
    let stop: (() => void) | undefined;
    let generation = 0, loadGeneration = 0, jobId = 0;
    let loadController: AbortController | undefined, exportController: AbortController | undefined;
    let downloadUrl: string | undefined;
    const message = (error: unknown): string => error instanceof Error ? error.message : String(error);
    const show = (text: string) => {if (scope.active) {bindingError = undefined; result.textContent = text;}};
    const paint = (): void => {
      if (!scope.active) return;
      const state = editor?.getState(), binding = player.documentBinding;
      status.textContent = state
        ? `Document ${documentStatus} · ${state.document.content.length} frames · revision ${state.document.documentRevision} · playback ${binding?.status ?? 'empty'}${binding?.applied ? ` (revision ${binding.applied.documentRevision})` : ''} · ${state.dirty ? 'unsaved' : 'saved'}`
        : `Document ${documentStatus}.`;
      exportButton.disabled = !state || state.document.status !== 'ready' || !!exportController;
      cancelButton.disabled = !state?.processing;
      for (const button of processButtons) button.disabled = !state || state.document.status !== 'ready' || state.processing;
      if (bindingError && result.textContent === bindingError && state?.document.status === 'ready' && binding?.status === 'ready'
        && binding.applied?.documentId === state.document.documentId && binding.applied.documentRevision === state.document.documentRevision) {
        bindingError = undefined; result.textContent = initialMessage;
      }
    };
    /** Lend `next` to both elements, then dispose the editor it replaces. */
    const install = (next: AudioClipEditor | undefined): void => {
      generation += 1; stop?.(); stop = undefined; exportController?.abort();
      const previous = editor;
      editor = next;
      if (next) documentStatus = 'ready';
      try { player.editor = next; view.editor = next; }
      catch (error) { show(message(error)); }
      if (previous && previous !== next) { previous.cancelProcessing(); previous.dispose(); }
      const current = generation;
      if (next) {
        const release = next.subscribeState(() => {if (scope.active && current === generation) paint();});
        if (scope.active && current === generation) stop = release; else release();
      }
      paint();
    };
    /** Supersede any pending configured load or file import. */
    const invalidateLoad = (): number => {
      loadGeneration += 1; loadController?.abort(); loadController = undefined;
      return loadGeneration;
    };
    const loadConfigured = async (): Promise<string> => {
      const current = invalidateLoad();
      const controller = new AbortController(); loadController = controller;
      documentStatus = 'loading'; paint();
      try {
        const loaded = await loadAudioClipEditor(source, {processors, signal: controller.signal});
        // A superseded result was never lent to an element; release it here.
        if (!scope.active || current !== loadGeneration) {loaded.dispose(); return 'superseded';}
        install(loaded);
        return 'ready';
      } catch (error) {
        if (!scope.active || current !== loadGeneration) return 'superseded';
        // A failed reload keeps the previous editor, if any.
        documentStatus = editor ? 'ready' : 'error'; paint();
        throw error;
      } finally {if (loadController === controller) loadController = undefined;}
    };
    scope.listen(player, 'webaudio:documentstatechange', paint);
    scope.listen(root, 'webaudio:error', event => {
      const detail: unknown = (event as CustomEvent).detail;
      const error = detail && typeof detail === 'object' && 'error' in detail ? detail.error : detail;
      show(message(error));
      if (error instanceof Error && 'code' in error && error.code === 'not-ready') bindingError = error.message;
    });
    scope.listen(upload, 'change', async () => {
      const file = upload.files?.[0]; if (!file) return;
      const current = invalidateLoad();
      const controller = new AbortController(); loadController = controller;
      const valid = () => scope.active && current === loadGeneration;
      try {
        const clip = await loadClip(file, {format: 'wav', signal: controller.signal});
        if (!valid()) return;
        install(createAudioClipEditor(clip, {processors}));
        show(`Imported ${file.name}.`);
      } catch (error) {if (valid()) show(message(error));}
      finally {if (loadController === controller) loadController = undefined; if (valid()) upload.value = '';}
    });
    for (const button of processButtons) {
      scope.listen(button, 'click', async () => {
        const target = editor, interaction = view.interactionSession?.getSnapshot(), selection = interaction?.selection;
        if (!target || !selection || selection.startFrame === selection.endFrame) {show('Select a nonempty range first.'); return;}
        const snapshot = target.getSnapshot();
        if (view.editor !== target || interaction?.documentId !== snapshot.documentId || interaction.disposed) {
          show('Bind the waveform to this audio document before processing its selection.'); return;
        }
        const id = ++jobId;
        const kind = button.dataset.audioEditProcess!;
        show(`Processing selection: ${kind}.`);
        const outcome = await target.processRange({documentId: snapshot.documentId, expectedRevision: snapshot.documentRevision,
          ...selection, processorId: kind, processorVersion: 1, parameters: kind === 'normalize' ? {targetPeak: .95} : {},
          assetId: `processed-asset-${id}`, segmentId: `processed-segment-${id}`, rightId: `processed-tail-${id}`, label: kind});
        if (scope.active && editor === target) show(outcome.status === 'failed' ? outcome.error.message : `Processing ${outcome.status}.`);
      });
    }
    scope.listen(cancelButton, 'click', () => {editor?.cancelProcessing();});
    scope.listen(exportButton, 'click', async () => {
      const exported = editor; if (!exported) return;
      exportController?.abort(); const controller = new AbortController(); exportController = controller; paint();
      try {
        const snapshot = exported.getSnapshot();
        const bytes = await exportAudioSequenceWav(snapshot.content, snapshot.assets, {signal: controller.signal});
        if (!scope.active || controller.signal.aborted || editor !== exported) return;
        if (downloadUrl) URL.revokeObjectURL(downloadUrl);
        downloadUrl = URL.createObjectURL(new Blob([bytes], {type: 'audio/wav'}));
        const link = document.createElement('a'); link.href = downloadUrl; link.download = 'edited-audio.wav'; link.click();
        if (exported.getSnapshot().status === 'ready' && exported.getSnapshot().contentId === snapshot.contentId) exported.markSaved();
        show(`WAV export requested for revision ${snapshot.documentRevision}.`);
      } catch (error) {if (!controller.signal.aborted) show(message(error));}
      finally {if (exportController === controller) exportController = undefined; paint();}
    });
    const restore = async (): Promise<void> => {
      upload.value = '';
      const pending = loadConfigured(), current = loadGeneration; show('Reloading configured source.');
      try {
        const outcome = await pending;
        if (scope.active && current === loadGeneration) show(outcome === 'ready' ? 'Configured source reloaded.' : `Reload ${outcome}.`);
      } catch (error) {if (scope.active && current === loadGeneration) show(String(error));}
    };
    scope.listen(root.querySelector('[data-audio-edit-restore]')!, 'click', restore);
    scope.listen(root.closest('[data-wm-pg]')!, PLAYGROUND_RESET_EVENT, () => {
      invalidateLoad(); queueMicrotask(() => {if (scope.active) scope.run(restore());});
    });
    scope.add(() => {
      invalidateLoad(); generation += 1; exportController?.abort(); stop?.(); stop = undefined;
      const owned = editor; editor = undefined;
      player.editor = undefined; view.editor = undefined;
      owned?.cancelProcessing(); owned?.dispose();
      if (downloadUrl) URL.revokeObjectURL(downloadUrl);
    });
    paint();
    void loadConfigured().catch((error: unknown) => {if (scope.active) show(message(error));});
  });
</script>

<style>
  [data-audio-edit-demo], [data-audio-edit-composition] {display:grid;grid-template-columns:minmax(0,1fr);gap:1rem;min-width:0;}
  [data-audio-edit-demo] p {margin:0;font-size:.85rem;overflow-wrap:anywhere;}
  .audio-edit-actions {display:flex;align-items:flex-start;gap:.5rem;flex-wrap:wrap;}
</style>
