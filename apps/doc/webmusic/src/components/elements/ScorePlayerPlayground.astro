---
// <score-player> — the transport widget on its own, loading Arabesque No. 1
// from `src`.
import ElementDemo from '../ElementDemo.astro';

const SRC = `${import.meta.env.BASE_URL}midi/Arabesque%20No.1.mid`;
---

<ElementDemo tag="score-player" class="sp-demo">
  <score-player src={SRC}></score-player>
</ElementDemo>

<script>
  import {defineScorePlayerElement} from '@webmusic/score/play/element';

  defineScorePlayerElement();
</script>

<style>
  /* :global so the rule reaches the transport the element builds at runtime */
  .sp-demo :global(score-player) {
    display: block;
  }
</style>
