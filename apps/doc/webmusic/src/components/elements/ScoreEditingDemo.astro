---
import ElementPlayground from '../ElementPlayground.astro';
import './editing-import.css';
interface Props {
  sourcePath?: string;
  idPrefix?: string;
}
const {sourcePath = 'midi/Arabesque%20No.1.mid', idPrefix = 'editing'} = Astro.props;
const source = `${import.meta.env.BASE_URL}${sourcePath}`;
const playerId = `${idPrefix}-player`;
---

<ElementPlayground tag="score-view" target="[data-editing-staff]" markup="[data-editing-composition]"
  companions={[{tag: 'score-grid-view', target: '[data-editing-grid]'}, {tag: 'score-player', target: '[data-editing-player]'}]}>
  <section data-editing-demo data-editing-src={source} aria-label="Shared MIDI editing workflow">
    <div data-editing-composition data-pg-fragment>
      <score-player data-editing-player id={playerId} time-control="full"></score-player>
      <score-grid-view data-editing-grid input={`#${playerId}`} editable note-height="14"></score-grid-view>
      <score-view data-editing-staff input={`#${playerId}`} type="staff"></score-view>
    </div>
    <p data-editing-status role="status">Loading Arabesque No. 1.</p>
    <div class="editing-actions">
      <label class="editing-import">Import MIDI <input data-editing-import type="file" accept=".mid,.midi,audio/midi" aria-label="Import MIDI" /></label>
      <button class="wui-btn" data-editing-export type="button">Export MIDI</button>
      <button class="wui-btn" data-editing-restore type="button">Reload configured source</button>
    </div>
    <p data-editing-result aria-live="polite">Edit notes in the grid, then press Play to hear the committed version. The read-only staff follows the same document.</p>
  </section>
</ElementPlayground>

<script>
  import {defineScoreGridViewElement, defineScoreViewElement, type ScoreGridViewElement, type ScoreViewElement} from '@webmusic/score/view/element';
  import {createScoreEditor, loadScoreEditor, type ScoreEditor} from '@webmusic/score/view/headless';
  import {defineScorePlayerElement, type ScorePlayerElement} from '@webmusic/score/play/element';
  import {loadScore, serializeMIDI, assertScoreInputByteLength, DEFAULT_LOAD_SCORE_LIMITS} from '@webmusic/score/io';
  import {mountDemos} from '../demo-lifecycle';
  import {PLAYGROUND_RESET_EVENT} from '../playground-client';
  defineScorePlayerElement(); defineScoreGridViewElement(); defineScoreViewElement();
  mountDemos('[data-editing-demo]', (root, scope) => {
    // The demo owns one editor at a time. The player, the editable grid and the
    // read-only staff borrow it through `.editor`; replacing or tearing down
    // disposes the previous one.
    const source = root.dataset.editingSrc!;
    const player = root.querySelector<ScorePlayerElement>('[data-editing-player]')!;
    const views = [...root.querySelectorAll<ScoreGridViewElement | ScoreViewElement>('score-grid-view, score-view')];
    const status = root.querySelector<HTMLElement>('[data-editing-status]')!;
    const result = root.querySelector<HTMLElement>('[data-editing-result]')!;
    const upload = root.querySelector<HTMLInputElement>('[data-editing-import]')!;
    const exportButton = root.querySelector<HTMLButtonElement>('[data-editing-export]')!;
    let editor: ScoreEditor | undefined;
    let documentStatus = 'loading';
    let stop: (() => void) | undefined;
    let generation = 0;
    let loadGeneration = 0;
    let loadController: AbortController | undefined;
    let downloadUrl: string | undefined;
    const initialResult = result.textContent;
    let transientBindingError = false;
    const showResult = (message: string, transient = false): void => {
      transientBindingError = transient;
      result.textContent = message;
    };
    const message = (error: unknown): string => error instanceof Error ? error.message : String(error);
    const paint = (): void => {
      if (!scope.active) return;
      const state = editor?.getState();
      const binding = player.documentBinding;
      status.textContent = state
        ? `Document ${documentStatus} · ${state.document.content.notes.length} notes · revision ${state.document.documentRevision} · playback ${binding?.status ?? 'empty'}${binding?.applied ? ` (revision ${binding.applied.documentRevision})` : ''} · ${state.dirty ? 'unsaved' : 'saved'}`
        : `Document ${documentStatus}.`;
      exportButton.disabled = !state || state.document.status !== 'ready';
      if (transientBindingError && state?.document.status === 'ready' && binding?.status === 'ready'
        && binding.applied?.documentId === state.document.documentId
        && binding.applied?.documentRevision === state.document.documentRevision) {
        showResult(initialResult ?? 'The document is ready to edit and play.');
      }
    };
    /** Lend `next` to every element, then dispose the editor it replaces. */
    const install = (next: ScoreEditor | undefined): void => {
      generation += 1; stop?.(); stop = undefined;
      const previous = editor;
      editor = next;
      documentStatus = next ? 'ready' : documentStatus;
      try {
        player.editor = next;
        for (const view of views) view.editor = next;
      } catch (error) {
        showResult(message(error));
      }
      if (previous && previous !== next) previous.dispose();
      const current = generation;
      if (next) {
        const release = next.subscribeState(() => { if (scope.active && current === generation) paint(); });
        if (scope.active && current === generation) stop = release; else release();
      }
      paint();
    };
    /** Supersede any pending configured load or file import. */
    const invalidateLoad = (): number => {
      loadGeneration += 1; loadController?.abort(); loadController = undefined;
      return loadGeneration;
    };
    const loadConfigured = async (): Promise<string> => {
      const current = invalidateLoad();
      const controller = new AbortController(); loadController = controller;
      documentStatus = 'loading'; paint();
      try {
        const loaded = await loadScoreEditor(source, {signal: controller.signal});
        // A superseded result was never lent to an element; release it here.
        if (!scope.active || current !== loadGeneration) { loaded.dispose(); return 'superseded'; }
        install(loaded);
        return 'ready';
      } catch (error) {
        if (!scope.active || current !== loadGeneration) return 'superseded';
        // A failed reload keeps the previous editor, if any.
        documentStatus = editor ? 'ready' : 'error'; paint();
        throw error;
      } finally {
        if (loadController === controller) loadController = undefined;
      }
    };
    scope.listen(player, 'webscore:documentstatechange', paint);
    scope.listen(root, 'webscore:error', (event) => {
      const error = (event as CustomEvent<{error: unknown}>).detail.error;
      const transient = event.target === player && error instanceof Error && 'code' in error && error.code === 'not-ready';
      showResult(message(error), transient);
    });
    scope.listen(upload, 'change', async () => {
      const file = upload.files?.[0]; if (!file) return;
      const current = invalidateLoad();
      const controller = new AbortController(); loadController = controller;
      const valid = () => scope.active && current === loadGeneration;
      try {
        assertScoreInputByteLength(file.size, DEFAULT_LOAD_SCORE_LIMITS.maxInputBytes, 'MIDI file');
        const bytes = await file.arrayBuffer();
        if (!valid()) return;
        const score = await loadScore(bytes, {format: 'midi', signal: controller.signal});
        if (!valid()) return;
        install(createScoreEditor(score));
        showResult(`Imported ${file.name}.`);
      } catch (error) {
        if (valid()) showResult(message(error));
      } finally {
        if (loadController === controller) loadController = undefined;
        if (valid()) upload.value = '';
      }
    });
    scope.listen(exportButton, 'click', () => {
      const exported = editor; if (!exported) return;
      try {
        const snapshot = exported.getSnapshot();
        const payload = new Uint8Array(serializeMIDI(snapshot.content));
        if (downloadUrl) URL.revokeObjectURL(downloadUrl);
        downloadUrl = URL.createObjectURL(new Blob([payload], {type: 'audio/midi'}));
        const link = document.createElement('a'); link.href = downloadUrl; link.download = 'edited-score.mid';
        link.click();
        if (editor === exported && exported.getSnapshot().status === 'ready' && exported.getSnapshot().contentId === snapshot.contentId) exported.markSaved();
        if (scope.active) showResult(`Export requested for revision ${snapshot.documentRevision}. MIDI exports playback data; it does not preserve every notation detail.`);
      } catch (error) {
        if (scope.active) showResult(message(error));
      }
    });
    const restore = async (): Promise<void> => {
      upload.value = '';
      const pending = loadConfigured();
      const current = loadGeneration;
      showResult('Reloading the configured source.');
      try {
        const outcome = await pending;
        if (scope.active && current === loadGeneration) showResult(outcome === 'ready' ? 'Configured source reloaded.' : `Reload ${outcome}.`);
      } catch (error) {
        if (scope.active && current === loadGeneration) showResult(String(error));
      }
    };
    scope.listen(root.querySelector('[data-editing-restore]')!, 'click', restore);
    scope.listen(root.closest('[data-wm-pg]')!, PLAYGROUND_RESET_EVENT, () => {
      invalidateLoad();
      queueMicrotask(() => { if (scope.active) scope.run(restore()); });
    });
    scope.add(() => {
      invalidateLoad(); generation += 1; stop?.(); stop = undefined;
      const owned = editor; editor = undefined;
      player.editor = undefined;
      for (const view of views) view.editor = undefined;
      owned?.dispose();
      if (downloadUrl) URL.revokeObjectURL(downloadUrl);
    });
    paint();
    void loadConfigured().catch((error: unknown) => { if (scope.active) showResult(message(error)); });
  });
</script>

<style>
  [data-editing-demo], [data-editing-composition] { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; min-width: 0; }
  [data-editing-demo] p { margin: 0; font-size: .85rem; overflow-wrap: anywhere; }
  .editing-actions { display: flex; align-items: flex-start; gap: .5rem; flex-wrap: wrap; }
</style>
