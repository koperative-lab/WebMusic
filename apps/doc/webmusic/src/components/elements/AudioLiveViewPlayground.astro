---
// <audio-live-view> — it draws what an AnalyserNode hears right now, so the demo
// ships the thing making the sound: an <audio-player> next to it.
//
// The component follows player readiness and tap replacement through `input`.
import ElementDemo from '../ElementDemo.astro';
import ElementComposition from '../ElementComposition.astro';

const SRC = `${import.meta.env.BASE_URL}mp3/Arabesque%20No.1.mp3`;
const PLAYER_ID = 'pg-live-view-player';
---

<ElementDemo tag="audio-live-view">
  <ElementComposition>
  <audio-player id={PLAYER_ID} src={SRC} controls></audio-player>
  <audio-live-view
    input={`#${PLAYER_ID}`}
    type="waveform"
    window-seconds="4"
    height="120"
    data-pg-live
  ></audio-live-view>
  </ElementComposition>
</ElementDemo>

<script>
  import { defineAudioPlayerElement } from '@webmusic/audio/play/element';
  import { defineAudioLiveViewElement } from '@webmusic/audio/view/element';

  defineAudioPlayerElement();
  defineAudioLiveViewElement();
</script>
