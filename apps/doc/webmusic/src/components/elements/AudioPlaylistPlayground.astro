---
// <audio-playlist> — the queue. The demo ships its entries as light-DOM
// children, which is the authoring form that degrades to a plain list without
// JavaScript: the element renders its own UI in a shadow root and never slots
// them, so the rows you see come from the queue, not from this markup.
//
// The same clip is queued twice under two ids (`data-id` — without it both rows
// would collapse onto the src as their id) so auto-advance has somewhere to go,
// and the MP3 is queued `data-streaming` to show the entry that is played
// rather than decoded. Typing into the `src` control takes over from the
// children, which is the one attribute swap worth watching here.
import ElementDemo from '../ElementDemo.astro';
import ElementComposition from '../ElementComposition.astro';

const WAV = `${import.meta.env.BASE_URL}wav/Arabesque%20No.1.wav`;
const MP3 = `${import.meta.env.BASE_URL}mp3/Arabesque%20No.1.mp3`;
const ENTRIES = [
  {id: 'wav-1', src: WAV, label: 'Arabesque No. 1 WAV · pass 1'},
  {id: 'wav-2', src: WAV, label: 'Arabesque No. 1 WAV · pass 2'},
  {id: 'mp3', src: MP3, label: 'Arabesque No. 1 MP3 · streamed', streaming: true},
];
---

<ElementDemo tag="audio-playlist">
  <ElementComposition>
    <audio-player id="playlist-session"></audio-player>
    <audio-playlist input="#playlist-session" loop>
      {ENTRIES.map((entry) => (
        <li data-id={entry.id} data-src={entry.src} data-label={entry.label} data-streaming={entry.streaming ? '' : undefined}>{entry.label}</li>
      ))}
    </audio-playlist>
  </ElementComposition>
</ElementDemo>

<script>
  import { defineAudioPlaylistElement, defineAudioPlayerElement } from '@webmusic/audio/play/element';
  defineAudioPlayerElement();
  defineAudioPlaylistElement();
</script>
