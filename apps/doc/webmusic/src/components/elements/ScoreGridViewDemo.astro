---
import ElementDemo from '../ElementDemo.astro';
import ElementComposition from '../ElementComposition.astro';
const source = `${import.meta.env.BASE_URL}midi/Arabesque%20No.1.mid`;
const features = ['move', 'resize', 'draw', 'delete', 'velocity', 'snap', 'zoom', 'history'];
---

<ElementDemo tag="score-grid-view">
  <section data-grid-demo data-grid-src={source} aria-label="Score grid editing">
    <ElementComposition>
      <score-player data-grid-player id="grid-player" time-control="full"></score-player>
      <score-grid-view data-grid-view input="#grid-player" editable tools={features.join(' ')} velocity-lane></score-grid-view>
    </ElementComposition>
    <p data-grid-status role="alert" hidden></p>
  </section>
</ElementDemo>

<script>
  import {defineScoreGridViewElement, type ScoreGridViewElement} from '@webmusic/score/view/element';
  import {loadScoreEditor, type ScoreEditor} from '@webmusic/score/view/headless';
  import {defineScorePlayerElement, type ScorePlayerElement} from '@webmusic/score/play/element';
  import {mountDemos} from '../demo-lifecycle';
  defineScorePlayerElement(); defineScoreGridViewElement();
  mountDemos('[data-grid-demo]', (root, scope) => {
    // The demo owns one editor at a time; the player and the grid borrow it.
    const source = root.dataset.gridSrc!;
    const player = root.querySelector<ScorePlayerElement>('[data-grid-player]')!;
    const grid = root.querySelector<ScoreGridViewElement>('[data-grid-view]')!;
    const status = root.querySelector<HTMLElement>('[data-grid-status]')!;
    let editor: ScoreEditor | undefined;
    let loadGeneration = 0;
    let loadController: AbortController | undefined;
    const message = (error: unknown): string => error instanceof Error ? error.message : String(error);
    // The canvas carries no narration; only a failed load is reported.
    const fail = (text: string): void => { if (scope.active) { status.textContent = text; status.hidden = false; } };

    /** Lend `next` to the player and grid, then dispose the editor it replaces. */
    const install = (next: ScoreEditor | undefined): void => {
      const previous = editor;
      editor = next;
      player.editor = next;
      grid.editor = next;
      if (previous && previous !== next) previous.dispose();
    };
    const load = async (): Promise<void> => {
      loadGeneration += 1; loadController?.abort();
      const current = loadGeneration;
      const controller = new AbortController(); loadController = controller;
      try {
        const loaded = await loadScoreEditor(source, {signal: controller.signal});
        // A superseded result was never lent to an element; release it here.
        if (!scope.active || current !== loadGeneration) { loaded.dispose(); return; }
        status.hidden = true;
        install(loaded);
      } catch (error) {
        if (scope.active && current === loadGeneration) fail(message(error));
      } finally {
        if (loadController === controller) loadController = undefined;
      }
    };

    // Toolbar, wheel and keyboard changes are reflected to attributes; keep Parameters current.
    scope.add(() => {
      loadGeneration += 1; loadController?.abort();
      const owned = editor; editor = undefined;
      player.editor = undefined;
      grid.editor = undefined;
      owned?.dispose();
    });
    scope.run(load());
  });
</script>

<style>
  [data-grid-demo] { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.5rem; min-width: 0; }
  [data-grid-demo] p { margin: 0; font-size: .85rem; overflow-wrap: anywhere; }
</style>
