---
import ElementPlayground from '../ElementPlayground.astro';
const source = `${import.meta.env.BASE_URL}midi/Editing.mid`;
const features = ['move', 'resize', 'draw', 'delete', 'velocity', 'snap', 'zoom', 'history'];
---

<ElementPlayground tag="score-grid-view" target="[data-grid-view]" markup="[data-grid-composition]"
  companions={[{tag: 'score-player', target: '[data-grid-player]'}]}>
  <section data-grid-demo data-grid-src={source} aria-label="Score grid editing">
    <fieldset class="grid-tools" data-grid-tools>
      <legend>Offered tools</legend>
      {features.map((feature) => (
        <label><input type="checkbox" value={feature} data-grid-feature checked /> {feature}</label>
      ))}
    </fieldset>
    <div data-grid-composition data-pg-fragment>
      <score-player data-grid-player id="grid-player" time-control="full"></score-player>
      <score-grid-view data-grid-view player="#grid-player" editable tools={features.join(' ')} velocity-lane min-pitch="58" max-pitch="74"></score-grid-view>
    </div>
    <p data-grid-status role="status">Loading the eight-note MIDI example.</p>
  </section>
</ElementPlayground>

<script>
  import {defineScoreGridViewElement, type ScoreGridSettingsChangeDetail, type ScoreGridViewElement} from '@webmusic/score/view/element';
  import {loadScoreEditor, type ScoreDraftResult, type ScoreEditor, type ScoreEditResult} from '@webmusic/score/view/headless';
  import {defineScorePlayerElement, type ScorePlayerElement} from '@webmusic/score/play/element';
  import {mountDemos} from '../demo-lifecycle';
  import {PLAYGROUND_RESET_EVENT, PLAYGROUND_SYNC_EVENT} from '../playground-client';
  defineScorePlayerElement(); defineScoreGridViewElement();
  mountDemos('[data-grid-demo]', (root, scope) => {
    // The demo owns one editor at a time; the player and the grid borrow it.
    const source = root.dataset.gridSrc!;
    const panel = root.closest<HTMLElement>('[data-wm-pg]');
    const player = root.querySelector<ScorePlayerElement>('[data-grid-player]')!;
    const grid = root.querySelector<ScoreGridViewElement>('[data-grid-view]')!;
    const status = root.querySelector<HTMLElement>('[data-grid-status]')!;
    const boxes = [...root.querySelectorAll<HTMLInputElement>('[data-grid-feature]')];
    let editor: ScoreEditor | undefined;
    let loadGeneration = 0;
    let loadController: AbortController | undefined;
    const message = (error: unknown): string => error instanceof Error ? error.message : String(error);
    const show = (text: string): void => { if (scope.active) status.textContent = text; };

    /** Lend `next` to the player and grid, then dispose the editor it replaces. */
    const install = (next: ScoreEditor | undefined): void => {
      const previous = editor;
      editor = next;
      player.editor = next;
      grid.editor = next;
      if (previous && previous !== next) previous.dispose();
    };
    const load = async (): Promise<void> => {
      loadGeneration += 1; loadController?.abort();
      const current = loadGeneration;
      const controller = new AbortController(); loadController = controller;
      try {
        const loaded = await loadScoreEditor(source, {signal: controller.signal});
        // A superseded result was never lent to an element; release it here.
        if (!scope.active || current !== loadGeneration) { loaded.dispose(); return; }
        install(loaded);
        show('Select a note, drag it, or switch to Draw and click empty space. Press Play to hear the committed notes.');
      } catch (error) {
        if (scope.active && current === loadGeneration) show(message(error));
      } finally {
        if (loadController === controller) loadController = undefined;
      }
    };

    // Demo chrome: each checkbox adds or removes one token of the `tools` attribute.
    const readTools = (): void => {
      const offered = new Set<string>(grid.tools);
      for (const box of boxes) box.checked = offered.has(box.value);
    };
    const syncPanel = (): void => { panel?.dispatchEvent(new CustomEvent(PLAYGROUND_SYNC_EVENT)); };
    for (const box of boxes) {
      scope.listen(box, 'change', () => {
        grid.setAttribute('tools', boxes.filter((entry) => entry.checked).map((entry) => entry.value).join(' '));
        syncPanel();
      });
    }
    // The tools text control, Reset and the toolbar also rewrite attributes.
    const observer = new MutationObserver(readTools);
    observer.observe(grid, {attributes: true, attributeFilter: ['tools']});
    scope.add(() => observer.disconnect());
    readTools();

    scope.listen(grid, 'gridsettingschange', (event) => {
      const {settings, changed} = (event as CustomEvent<ScoreGridSettingsChangeDetail>).detail;
      show(`gridsettingschange: ${changed} → ${String(settings[changed])}`);
      syncPanel();
    });
    scope.listen(grid, 'editpreview', (event) => {
      const result = (event as CustomEvent<Extract<ScoreDraftResult, {status: 'preview'}>>).detail;
      show(`editpreview: draft over revision ${result.snapshot.draft?.documentRevision ?? '—'} · ${result.snapshot.selectedNoteIds.length} selected`);
    });
    scope.listen(grid, 'editcommit', (event) => {
      const result = (event as CustomEvent<Extract<ScoreEditResult, {status: 'committed'}>>).detail;
      show(`editcommit: ${result.change.label} · revision ${result.snapshot.documentRevision}`);
    });
    scope.listen(grid, 'editerror', (event) => show(`editerror: ${message((event as CustomEvent<{error: unknown}>).detail.error)}`));
    if (panel) {
      // Reset restores the authored attributes; reloading also discards the edits.
      scope.listen(panel, PLAYGROUND_RESET_EVENT, () => {
        queueMicrotask(() => { if (scope.active) { readTools(); scope.run(load()); } });
      });
    }
    scope.add(() => {
      loadGeneration += 1; loadController?.abort();
      const owned = editor; editor = undefined;
      player.editor = undefined;
      grid.editor = undefined;
      owned?.dispose();
    });
    scope.run(load());
  });
</script>

<style>
  [data-grid-demo], [data-grid-composition] { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; min-width: 0; }
  [data-grid-demo] p { margin: 0; font-size: .85rem; overflow-wrap: anywhere; }
  .grid-tools { display: flex; flex-wrap: wrap; gap: .25rem 1rem; margin: 0; padding: .5rem .75rem; border: 1px solid var(--wui-line-control); font-size: .85rem; }
  .grid-tools legend { padding: 0 .25rem; font-weight: 600; }
  .grid-tools label { display: inline-flex; align-items: center; gap: .25rem; }
</style>
