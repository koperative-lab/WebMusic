---
import ElementDemo from '../ElementDemo.astro';
import ElementComposition from '../ElementComposition.astro';
interface Props { tag: 'score-chord-analysis' | 'score-interval-analysis' | 'score-scale-analysis' | 'score-rhythm-analysis'; }
const {tag} = Astro.props;
const playerId = `pg-${tag}-player`;
const SRC = `${import.meta.env.BASE_URL}mxl/Arabesque%20No.1.mxl`;
---

<ElementDemo tag={tag}>
  <ElementComposition>
    <score-player id={playerId} src={SRC}></score-player>
    {tag === 'score-chord-analysis' && <score-chord-analysis input={`#${playerId}`} window="1" grouping="beat"></score-chord-analysis>}
    {tag === 'score-interval-analysis' && <score-interval-analysis input={`#${playerId}`} window="1"></score-interval-analysis>}
    {tag === 'score-scale-analysis' && <score-scale-analysis input={`#${playerId}`} window="1" tonic="E" scale="major"></score-scale-analysis>}
    {tag === 'score-rhythm-analysis' && <score-rhythm-analysis input={`#${playerId}`} window="1"></score-rhythm-analysis>}
  </ElementComposition>
</ElementDemo>

<script>
  import {defineScorePlayerElement} from '@webmusic/score/play/element';
  import {defineAllAnalysisElements} from '@webmusic/score/analyze/element';
  defineScorePlayerElement();
  defineAllAnalysisElements();
</script>
