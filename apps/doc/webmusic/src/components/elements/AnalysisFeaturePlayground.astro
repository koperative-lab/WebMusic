---
import ElementPlayground from '../ElementPlayground.astro';
import ElementComposition from '../ElementComposition.astro';
interface Props { tag: 'score-chord-analysis' | 'score-live-chord-analysis'; }
const {tag} = Astro.props;
const playerId = `pg-${tag}-player`;
const SRC = `${import.meta.env.BASE_URL}midi/Arabesque%20No.1.mid`;
const companions = [{tag: 'score-player', target: 'score-player'}];
---

<ElementPlayground tag={tag} markup="[data-demo-composition]" companions={companions}>
  <ElementComposition>
    <score-player id={playerId} src={SRC}></score-player>
    {tag === 'score-chord-analysis' && <score-chord-analysis player={`#${playerId}`}></score-chord-analysis>}
    {tag === 'score-live-chord-analysis' && <score-live-chord-analysis player={`#${playerId}`}></score-live-chord-analysis>}
  </ElementComposition>
</ElementPlayground>

<script>
  import {defineScorePlayerElement} from '@webmusic/score/play/element';
  import {defineAllAnalysisElements} from '@webmusic/score/analyze/element';
  defineScorePlayerElement();
  defineAllAnalysisElements();
</script>
