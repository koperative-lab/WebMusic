---
// <score-sheet-view> engraves Arabesque No. 1 from its MusicXML, the format
// that carries clefs, key signatures, voices and staff assignment. The page
// owns one editor and lends it to the player and the sheet.
import ElementDemo from '../ElementDemo.astro';
import ElementComposition from '../ElementComposition.astro';

const source = `${import.meta.env.BASE_URL}mxl/Arabesque%20No.1.mxl`;
const features = ['pitch', 'input', 'duration', 'tie', 'accidental', 'delete', 'history', 'zoom'];
---

<ElementDemo tag="score-sheet-view">
  <section data-sheet-demo data-sheet-src={source} aria-label="Score sheet editing">
    <ElementComposition>
      <score-player data-sheet-player id="sheet-player" time-control="full"></score-player>
      <score-sheet-view data-sheet-view input="#sheet-player" editable tools={features.join(' ')}></score-sheet-view>
    </ElementComposition>
    <p data-sheet-status role="alert" hidden></p>
  </section>
</ElementDemo>

<script>
  import {defineSheetViewElement, type SheetViewElement} from '@webmusic/score/view/element';
  import {loadScoreEditor, type ScoreEditor} from '@webmusic/score/view/headless';
  import {defineScorePlayerElement, type ScorePlayerElement} from '@webmusic/score/play/element';
  import {mountDemos} from '../demo-lifecycle';
  defineScorePlayerElement(); defineSheetViewElement();
  mountDemos('[data-sheet-demo]', (root, scope) => {
    // The demo owns one editor at a time; the player and the sheet borrow it.
    const source = root.dataset.sheetSrc!;
    const player = root.querySelector<ScorePlayerElement>('[data-sheet-player]')!;
    const sheet = root.querySelector<SheetViewElement>('[data-sheet-view]')!;
    const status = root.querySelector<HTMLElement>('[data-sheet-status]')!;
    let editor: ScoreEditor | undefined;
    let loadGeneration = 0;
    let loadController: AbortController | undefined;
    const message = (error: unknown): string => error instanceof Error ? error.message : String(error);
    // The canvas carries no narration; only a failed load is reported.
    const fail = (text: string): void => { if (scope.active) { status.textContent = text; status.hidden = false; } };

    /** Lend `next` to the player and sheet, then dispose the editor it replaces. */
    const install = (next: ScoreEditor | undefined): void => {
      const previous = editor;
      editor = next;
      player.editor = next;
      sheet.editor = next;
      if (previous && previous !== next) previous.dispose();
    };
    const load = async (): Promise<void> => {
      loadGeneration += 1; loadController?.abort();
      const current = loadGeneration;
      const controller = new AbortController(); loadController = controller;
      try {
        const loaded = await loadScoreEditor(source, {signal: controller.signal});
        // A superseded result was never lent to an element; release it here.
        if (!scope.active || current !== loadGeneration) { loaded.dispose(); return; }
        status.hidden = true;
        install(loaded);
      } catch (error) {
        if (scope.active && current === loadGeneration) fail(message(error));
      } finally {
        if (loadController === controller) loadController = undefined;
      }
    };

    // Toolbar and keyboard changes are reflected to attributes; keep Parameters current.
    scope.add(() => {
      loadGeneration += 1; loadController?.abort();
      const owned = editor; editor = undefined;
      player.editor = undefined;
      sheet.editor = undefined;
      owned?.dispose();
    });
    scope.run(load());
  });
</script>

<style>
  [data-sheet-demo] { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.5rem; min-width: 0; }
  [data-sheet-demo] p { margin: 0; font-size: .85rem; overflow-wrap: anywhere; }
</style>
