---
// Homepage workbench: a player driving a live waveform. Shows the cross-package
// data flow — @webmusic/audio/play loads + decodes the clip, @webmusic/audio/analyze turns it
// into a peaks pyramid, @webmusic/audio/view draws it, and the <audio-view> follows the
// <audio-player> through its public source, readiness and time contracts
// (view never imports play or analyze).
import LiveDemoCanvas from './LiveDemoCanvas.astro';
---

<div class="wui-panel wui-panel--flow not-content" data-audio-workbench>
  <div class="wui-panel__title">
    <span>@webmusic/audio/play + analyze + view</span>
    <strong>&lt;audio-player&gt; → &lt;audio-view&gt;</strong>
  </div>
  <LiveDemoCanvas>
    <audio-player id="wa-wb-player" controls></audio-player>
    <audio-view id="wa-wb-view" input="#wa-wb-player" type="waveform" pixels-per-second="90" interactive></audio-view>
    <p role="status" data-workbench-status></p>
  </LiveDemoCanvas>
</div>

<script>
  import type { AudioPlayerElement } from '@webmusic/audio/play/element';
  import type { AudioViewElement } from '@webmusic/audio/view/element';
  import { defineAudioPlayerElement } from '@webmusic/audio/play/element';
  import { defineAudioViewElement } from '@webmusic/audio/view/element';
  import {mountDemos} from './demo-lifecycle';
  import {acquireAudioViewFixture} from './audio-view-fixture';

  defineAudioPlayerElement();
  defineAudioViewElement();

  mountDemos('[data-audio-workbench]', (root, scope) => {
    const player = root.querySelector<AudioPlayerElement>('audio-player')!;
    const view = root.querySelector<AudioViewElement>('audio-view')!;
    const status = root.querySelector<HTMLElement>('[data-workbench-status]')!;
    const fixture = acquireAudioViewFixture(`${import.meta.env.BASE_URL}wav/Arabesque%20No.1.wav`);
    scope.add(() => fixture.release());
    scope.add(() => { player.stop(); player.clip = undefined; player.loading = false; view.peaks = undefined; view.loading = false; });
    status.textContent = '';
    player.loading = true;
    view.loading = true;
    scope.run((async () => {
      const [clip, peaks] = await Promise.all([fixture.clip(), fixture.peaks()]);
      if (!scope.active) return;
      view.peaks = peaks;
      player.clip = clip;
      player.loading = false;
      view.loading = false;
    })(), () => {
      player.loading = false;
      view.loading = false;
      status.textContent = 'Audio could not be loaded. Reload this page to retry.';
    });
  });
</script>

<style>
  [data-audio-workbench] :global(audio-player) {
    display: block;
    margin-bottom: 0.6rem;
  }

  [data-audio-workbench] :global(audio-view) {
    display: block;
    min-height: 130px;
  }
</style>
