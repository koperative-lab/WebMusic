---
// Canonical demo pattern: drop the tag, build a small AudioMixer in a client
// script block and assign `.members` to the owning element. Two members share one clip and a scheduled start, which is what gives
// the desk two strips — and gives `solo` an id to actually name.
import ElementDemo from './ElementDemo.astro';
import ElementComposition from './ElementComposition.astro';

const SRC = `${import.meta.env.BASE_URL}wav/Arabesque%20No.1.wav`;
---

<ElementDemo tag="audio-mixer">
  <ElementComposition>
    <audio-player id="mixer-session"></audio-player>
    <audio-mixer input="#mixer-session" id="wa-mixer-demo" data-src={SRC}></audio-mixer>
    <p role="status" data-mixer-status hidden></p>
  </ElementComposition>
</ElementDemo>

<script>
  import { loadClipFromUrl } from '@webmusic/audio/play';
  import { defineAudioMixerElement, defineAudioPlayerElement } from '@webmusic/audio/play/element';
  import type { AudioMixerElement, AudioPlayerElement } from '@webmusic/audio/play/element';
  import { mountDemos } from './demo-lifecycle';

  defineAudioPlayerElement();
  defineAudioMixerElement();

  mountDemos('[data-wm-pg]:has(#wa-mixer-demo)', (root, scope) => {
    const el = root.querySelector<AudioMixerElement>('#wa-mixer-demo')!;
    const player = root.querySelector<AudioPlayerElement>('#mixer-session')!;
    const status = root.querySelector<HTMLElement>('[data-mixer-status]')!;
    // The template always renders the tag with data-src.
    const src = el.dataset.src!;
    // Reuse one decoded clip for both members; the mixer plays them on a single
    // context and propose a common future start for the two strips.
    player.loading = el.loading = true;
    status.textContent = '';
    status.hidden = true;
    scope.add(() => { player.loading = el.loading = false; el.members = undefined; });
    scope.run((async () => {
      try {
        const clip = await loadClipFromUrl(src, {signal: scope.signal});
        if (!scope.active) return;
        el.members = [
          {id: 'track A', clip},
          {id: 'track B', clip, volume: 0.6},
        ];
      } finally {
        if (scope.active) player.loading = el.loading = false;
      }
    })(), () => {
      status.textContent = 'Audio could not be loaded. Reload this page to retry.';
      status.hidden = false;
    });
  });
</script>
