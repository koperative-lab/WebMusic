---
/**
 * Site icons in the visual design: a 24-unit view box drawn at 16px,
 * `currentColor` stroke 1.5, no fill, square caps and mitred joins. The name
 * belongs on the control that holds the icon; the icon itself is hidden.
 */
interface Props { name: 'search' | 'close' | 'menu' | 'chevron' | 'copy' | 'check' | 'github' | 'prev' | 'next' }
const {name} = Astro.props;
const paths: Record<Props['name'], string> = {
