{
  "name": "webmusic-library",
  "private": true,
  "type": "module",
  "description": "WebMusic component library: every Web Component by function, searchable, with live Arabesque previews and an app composer",
  "scripts": {
    "dev": "vite --port 4341 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4341 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@webmusic/audio": "^0.3.0",
    "@webmusic/kernel": "^0.3.0",
    "@webmusic/score": "^0.3.0",
    "@webmusic/ui": "^0.3.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.1.0"
  }
}
