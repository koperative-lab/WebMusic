{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "platform/kernel/test/**/*.ts",
    "packages/ui/test/**/*.ts",
    "packages/ui/test/**/*.tsx",
    "packages/score/test/**/*.ts",
    "packages/score/test/**/*.tsx",
    "apps/doc/webmusic/test/**/*.ts"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**"
  ]
}
