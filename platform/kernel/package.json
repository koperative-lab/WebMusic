{
  "name": "@webmusic/kernel",
  "version": "0.1.0",
  "description": "Domain-neutral WebMusic contracts and utilities for events, elements, workers, metering and synchronized playback.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./events": {
      "import": {
        "types": "./dist/events.d.ts",
        "default": "./dist/events.js"
      },
      "require": {
        "types": "./dist/events.d.cts",
        "default": "./dist/events.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/elements.d.ts",
        "default": "./dist/elements.js"
      },
      "require": {
        "types": "./dist/elements.d.cts",
        "default": "./dist/elements.cjs"
      }
    },
    "./worker": {
      "import": {
        "types": "./dist/worker.d.ts",
        "default": "./dist/worker.js"
      },
      "require": {
        "types": "./dist/worker.d.cts",
        "default": "./dist/worker.cjs"
      }
    },
    "./audio-context": {
      "import": {
        "types": "./dist/audio-context.d.ts",
        "default": "./dist/audio-context.js"
      },
      "require": {
        "types": "./dist/audio-context.d.cts",
        "default": "./dist/audio-context.cjs"
      }
    },
    "./player": {
      "import": {
        "types": "./dist/player.d.ts",
        "default": "./dist/player.js"
      },
      "require": {
        "types": "./dist/player.d.cts",
        "default": "./dist/player.cjs"
      }
    },
    "./effect": {
      "import": {
        "types": "./dist/effect.d.ts",
        "default": "./dist/effect.js"
      },
      "require": {
        "types": "./dist/effect.d.cts",
        "default": "./dist/effect.cjs"
      }
    },
    "./meter": {
      "import": {
        "types": "./dist/meter.d.ts",
        "default": "./dist/meter.js"
      },
      "require": {
        "types": "./dist/meter.d.cts",
        "default": "./dist/meter.cjs"
      }
    },
    "./transport": {
      "import": {
        "types": "./dist/transport.d.ts",
        "default": "./dist/transport.js"
      },
      "require": {
        "types": "./dist/transport.d.cts",
        "default": "./dist/transport.cjs"
      }
    },
    "./tick": {
      "import": {
        "types": "./dist/tick.d.ts",
        "default": "./dist/tick.js"
      },
      "require": {
        "types": "./dist/tick.d.cts",
        "default": "./dist/tick.cjs"
      }
    },
    "./sync": {
      "import": {
        "types": "./dist/sync.d.ts",
        "default": "./dist/sync.js"
      },
      "require": {
        "types": "./dist/sync.d.cts",
        "default": "./dist/sync.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/events.ts src/elements.ts src/worker.ts src/audio-context.ts src/player.ts src/effect.ts src/meter.ts src/transport.ts src/tick.ts src/sync.ts --tsconfig tsconfig.build.json --format esm,cjs --splitting --dts --sourcemap --clean && node ../../scripts/package-artifacts.mjs --write",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/package-artifacts.mjs"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "mrsteamedbun",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koperative-lab/WebMusic.git",
    "directory": "platform/kernel"
  },
  "homepage": "https://github.com/koperative-lab/WebMusic/tree/main/platform/kernel#readme",
  "bugs": {
    "url": "https://github.com/koperative-lab/WebMusic/issues"
  },
  "keywords": [
    "music",
    "web-audio",
    "transport",
    "typescript",
    "webmusic",
    "kernel"
  ]
}
